# ---------------------------------------------------------------------------
# opadbisrescue — environment configuration
#
# The application runs with NO required environment variables. Every value
# below is OPTIONAL and exists only to override a built-in default.
#
# Naming rules:
#   VITE_*  -> exposed to the browser bundle (never put secrets here)
#   others  -> server-only, readable inside server-function handlers
#
# See docs/configuration.md for the full reference.
# ---------------------------------------------------------------------------

# --- Server / runtime -------------------------------------------------------
# Purpose : Dev server port.
# Required: no       Default: 8080        Example: 8080
PORT=8080

# Purpose : Build/runtime mode.
# Required: no       Default: development Example: production
NODE_ENV=development

# --- OpenStreetMap data sources (server-side) -------------------------------
# Purpose : Comma-separated Overpass API interpreter endpoints, tried in order.
#           Set this to point at a self-hosted Overpass instance for higher
#           rate limits and reliability.
# Required: no
# Default : https://maps.mail.ru/osm/tools/overpass/api/interpreter,
#           https://overpass-api.de/api/interpreter,
#           https://overpass.kumi.systems/api/interpreter,
#           https://overpass.private.coffee/api/interpreter
# Example : https://overpass.internal.example.org/api/interpreter
OVERPASS_ENDPOINTS=

# Purpose : Overpass request timeout in milliseconds.
# Required: no       Default: 60000       Example: 90000
OVERPASS_TIMEOUT_MS=60000

# Purpose : User-Agent sent to OSM services. OSM policy requires a
#           descriptive, contactable identifier for production deployments.
# Required: no
# Default : opadbisrescue GIS Dashboard/1.0 (OpenStreetMap data viewer)
# Example : MyOrg opadbisrescue/1.2 (gis@myorg.example)
OSM_USER_AGENT=

# Purpose : Nominatim base URL used for administrative boundary lookup.
# Required: no       Default: https://nominatim.openstreetmap.org
# Example : https://nominatim.internal.example.org
NOMINATIM_BASE_URL=

# --- Routing (client-side) --------------------------------------------------
# Purpose : OSRM routing server base URL used for emergency navigation.
#           The public demo server is rate limited and unsuitable for
#           production traffic — host your own OSRM for real deployments.
# Required: no       Default: https://router.project-osrm.org
# Example : https://osrm.myorg.example
VITE_OSRM_BASE_URL=

# --- Map defaults (client-side) --------------------------------------------
# Purpose : Basemap selected on first load.
# Required: no       Default: carto-light
# Allowed : osm | hot | esri-imagery | carto-light | carto-dark
VITE_DEFAULT_BASEMAP=carto-light

# Purpose : Initial map centre "lat,lng".
# Required: no       Default: 9.08,8.68   Example: 7.38,3.94
VITE_DEFAULT_CENTER=9.08,8.68

# --- Analytics / error reporting (optional) ---------------------------------
# Purpose : Enable anonymous usage analytics. Leave blank to disable.
# Required: no       Default: (disabled)  Example: https://plausible.example/api/event
VITE_ANALYTICS_ENDPOINT=

# Purpose : Error-reporting DSN. Leave blank to disable.
# Required: no       Default: (disabled)  Example: https://abc@sentry.example/1
VITE_ERROR_REPORTING_DSN=
